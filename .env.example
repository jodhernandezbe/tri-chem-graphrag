# Copy to .env and fill in. The real .env is git-ignored.

# Deployment environment label.
ENVIRONMENT=dev

# US Census API key (NAICS enrichment during graph extraction).
CENSUS_DATA_API_KEY=your-census-api-key

# RAGAS judge keys (docs/RESULTS.md §7). The judge needs a GPT-4-class model — local 7-14B
# judges cannot emit RAGAS' faithfulness/recall schemas, and the smallest local one that can
# (qwen2.5:32b) is too slow. Set the key for whichever RAG_GRAPH.RAGAS.JUDGE_PROVIDER you use;
# `python -m src.validation.main --steps ragas` fails loudly at startup if the key is missing.
#   JUDGE_PROVIDER: openai       → OPENAI_API_KEY  (e.g. gpt-4o-mini)
#   JUDGE_PROVIDER: ollama_cloud → OLLAMA_API_KEY  (e.g. gpt-oss:120b-cloud)
#   JUDGE_PROVIDER: ollama_local → no key (local Ollama; precision only)
OPENAI_API_KEY=your-openai-api-key
OLLAMA_API_KEY=your-ollama-cloud-api-key
